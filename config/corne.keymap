#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

// Positions physiques du Corne (42 touches), utilisees par les home row mods.
#define KEYS_L  0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

// Liberer P0.06 pour le CS du nice!view.
//
// Deux noeuds se disputent cette broche :
//   - le CS de l'ecran, cs-gpios = <&pro_micro 1 ...> dans
//     nice_view_adapter/boards/nice_nano_v2.overlay, et pro_micro 1 vaut
//     <&gpio0 6> d'apres arduino_pro_micro_pins.dtsi ;
//   - le MOSI de SPIM3 pour le ruban WS2812, NRF_PSEL(SPIM_MOSI, 0, 6) avec
//     status = "okay" inconditionnel, dans corne/boards/nice_nano_v2.overlay.
//
// Quand pinctrl attribue P0.06 a SPIM3, le CS ne bascule plus et le ls0xx
// emet des trames completes que la dalle n'accepte jamais : c'est exactement
// ce que montre le log (ls0xx_write 160x68 en boucle, ecran noir).
// On n'utilise pas l'underglow, donc desactiver spi3 ne coute rien.
&spi3 {
    status = "disabled";
};

/ {
    behaviors {
        // Home row mods. Le maintien ne declenche le modificateur que si la
        // touche suivante est sur l'AUTRE main (ou un pouce) : c'est ce qui
        // evite les faux positifs quand on roule sur A-R-S-T.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    // Macros d'accents : macOS, disposition systeme U.S.
    //
    // Option est pressee dans un rapport HID separe de la lettre : envoyer
    // LA(x) en un seul rapport fait rater la touche morte sous macOS.
    //   Option + E -> aigu         Option + ` -> grave
    //   Option + I -> circonflexe  Option + U -> trema
    //
    // e-aigu utilise l'Option DROITE. C'est le seul accent pose au-dessus d'un
    // home row mod qui porte le meme modificateur (position 15 = &hml LALT S),
    // et c'est le seul qui ne sortait pas. RALT supprime le recouvrement.
    macros {
        m_eacute: m_eacute {      // e aigu     Option DROITE + E puis e
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp RALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp RALT>
                     , <&macro_tap &kp E>;
        };

        m_egrave: m_egrave {      // e grave    Option+` puis e
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp E>;
        };

        m_ecirc: m_ecirc {      // e circ     Option+i puis e
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp I>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp E>;
        };

        m_agrave: m_agrave {      // a grave    Option+` puis a
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp A>;
        };

        m_acirc: m_acirc {      // a circ     Option+i puis a
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp I>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp A>;
        };

        m_icirc: m_icirc {      // i circ     Option+i puis i
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp I>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp I>;
        };

        m_ocirc: m_ocirc {      // o circ     Option+i puis o
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp I>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp O>;
        };

        m_ugrave: m_ugrave {      // u grave    Option+` puis u
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp U>;
        };

        m_ucirc: m_ucirc {      // u circ     Option+i puis u
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp I>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp U>;
        };

        m_udier: m_udier {      // u trema    Option+u puis u
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp U>;
        };

        m_toto: m_toto {              // totototo42$
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp T &kp O &kp T &kp O &kp T &kp O &kp T &kp O
                        &kp N4 &kp N2 &kp LS(N4)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            //  ---------------------------------------------------------------------------------------
            //  | ESC  |  Q  |  W  |  F  |  P  |  G  |     |  J  |  L  |  U  |  Y  |  ;  | BKSP |
            //  | TAB  |  A  |  R  |  S  |  T  |  D  |     |  H  |  N  |  E  |  I  |  O  |  '   |
            //  | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  K  |  M  |  ,  |  .  |  /  | SHFT |
            //                     | GUI | LWR | SPC |     | ENT | RSE | CMD |
            //  Home row mods :  A=SHFT  R=CTRL  S=ALT  T=GUI    N=GUI  E=ALT  I=CTRL  O=SHFT
            bindings = <
&kp ESC    &kp Q          &kp W          &kp F          &kp P          &kp G          &kp J     &kp L          &kp U          &kp Y          &kp SEMI       &kp BSPC
&kp TAB    &hml LSHFT A   &hml LCTRL R   &hml LALT S    &hml LGUI T    &kp D          &kp H     &hmr RGUI N    &hmr RALT E    &hmr RCTRL I   &hmr RSHFT O   &kp SQT
&kp LSHFT  &kp Z          &kp X          &kp C          &kp V          &kp B          &kp K     &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
                                         &kp LGUI       &mo LOWER      &kp SPACE      &kp RET   &mo RAISE      &kp RGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            //  ---------------------------------------------------------------------------------------
            //  |  `   |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            //  | TAB  |  !  |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  |  |   |
            //  | SHFT |  =  |  -  |  +  |  {  |  }  |     |  [  |  ]  |  ;  |  :  |  \  | SHFT |
            //                     | GUI |     | SPC |     | ENT | ADJ | ALT |
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp PIPE
&kp LSHFT  &kp EQUAL  &kp MINUS  &kp PLUS   &kp LBRC   &kp RBRC       &kp LBKT   &kp RBKT   &kp SEMI   &kp COLON  &kp BSLH   &kp RSHFT
                                 &kp LGUI   &trans     &kp SPACE      &kp RET    &mo ADJUST &kp RGUI
            >;
        };

        raise_layer {
            display-name = "Raise";
            //  ---------------------------------------------------------------------------------------
            //  | ESC  |  u  |  a  |  o  |  i  |TOTO |     | PGUP|     |  UP |     | F12 | BKSP |
            //  | TAB  |  a  |  e  |  e  |  u  |  u  |     | PGDN| LFT | DWN | RGT | DEL |      |
            //  | SHFT |     |     |  e  |     |     |     | CAPS|     |     |     |     |      |
            //                     | GUI | ADJ | SPC |     | ENT |     | ALT |
            bindings = <
&kp ESC    &m_udier   &m_acirc   &m_ocirc   &m_icirc   &m_toto        &kp PG_UP  &none      &kp UP     &none      &kp F12    &kp BSPC
&kp TAB    &m_agrave  &m_egrave  &m_eacute  &m_ugrave  &m_ucirc       &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp DEL    &none
&kp LSHFT  &none      &none      &m_ecirc   &none      &none          &kp CAPS   &none      &none      &none      &none      &none
                                 &kp LGUI   &mo ADJUST &kp SPACE      &kp RET    &trans     &kp RGUI
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            //  ---------------------------------------------------------------------------------------
            //  | UNLK | BT0 | BT1 | BT2 | BT3 | BT4 |     |  /  |  7  |  8  |  9  |  -  | BKSP |
            //  | BOOT | CLR | USB | BLE |     |     |     |  *  |  4  |  5  |  6  |  +  | KENT |
            //  | RST  |CLRAL|     |     |     |     |     |  0  |  1  |  2  |  3  |  .  |  =   |
            //                     |     |     |     |     |     |     |     |
            bindings = <
&studio_unlock  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp BSPC
&bootloader     &bt BT_CLR      &out OUT_USB  &out OUT_BLE  &none         &none             &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp KP_ENTER
&sys_reset      &bt BT_CLR_ALL  &none         &none         &none         &none             &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp KP_EQUAL
                                              &trans        &trans        &trans            &trans           &trans     &trans
            >;
        };

        // Couches vides de reserve : elles ne servent a rien telles quelles,
        // mais elles permettent de creer de nouvelles couches depuis ZMK Studio
        // sans avoir a recompiler le firmware.
        spare_1 {
            display-name = "Spare 1";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        spare_2 {
            display-name = "Spare 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };
    };
};
